# Target base URL (default: https://anikoto.net)
BASE_URL=https://anikoto.net

# Optional: CORS allowed origins (default: "*")
CORS_ALLOWED_ORIGIN=*

# Optional: Cloudflare Worker URL for video streaming proxy only (m3u8 & video segments)
CF_WORKER_URL=https://your-worker-name.workers.dev

# Optional: Comma-separated list of HTTP/HTTPS/SOCKS outbound proxies for scraping
# (supports PROXIES, PROXY_LIST, OUTBOUND_PROXY_URL, or SCRAPER_PROXY_URL)
# PROXIES=http://user:pass@node1.proxy.com:8080,http://node2.proxy.com:8080