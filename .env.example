# Target base URL (default: https://anikoto.net)
BASE_URL=https://anikoto.net

# Optional: CORS allowed origins (default: "*")
CORS_ALLOWED_ORIGIN=*

# Optional: Cloudflare Worker URL for video streaming proxy only (m3u8 & video segments)
CF_WORKER_URL=https://your-worker-name.workers.dev

# Optional: Comma-separated list of additional permitted streaming domains for /api/proxy
# ALLOWED_PROXY_HOSTS=*.example-cdn.com,cdn.streamingservice.net

# Optional: Comma-separated list of HTTP/HTTPS/SOCKS outbound proxies for scraping
# (supports PROXIES, PROXY_LIST, OUTBOUND_PROXY_URL, or SCRAPER_PROXY_URL)
# PROXIES=http://user:pass@node1.proxy.com:8080,http://node2.proxy.com:8080

# Optional: Brotli response compression (falls back to gzip, then identity). Default: off
# ENABLE_BROTLI=true
# BROTLI_QUALITY=5
# GZIP_LEVEL=6
# COMPRESSION_MIN_BYTES=1024

# Optional: fallback upstream mirrors tried in order after BASE_URL
# MIRROR_DOMAINS=https://anikototv.to,https://anikoto.cz
# MIRROR_COOLDOWN_MS=60000

# Optional: require "Authorization: Bearer <token>" for POST /api/mirrors/reset
# ADMIN_TOKEN=change-me

# Optional: default Referer for /api/stream/qualities
# STREAM_PROXY_REFERER=https://megaplay.buzz/
